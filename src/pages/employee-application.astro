---
import Layout from "../layouts/Layout.astro";
import "../styles/subcontractor.css"
import "aos/dist/aos.css";
import image from "@astrojs/react";
import waterImage from "../assets/employee/employee.png";
import { Image } from "astro:assets";

const currentYear = new Date().getFullYear();
import { getSEO } from "../utils/getSEO";
const seo = getSEO("employee");
---

<Layout title={seo.title} description={seo.description} keywords={seo.keywords}>

    <section>
<div class="inner-banner">
  <div class="inner-banner-content">
    <h1>Employee Application Form</h1>

  </div>
  </div>
</section>

<section class="subcontractor-wrapper">
  <div class="subcontractor-container">

    <div class="form-header">
      <p class="top-label">• JOIN THE TEAM</p>
      <h2>Employee Application</h2>
    </div>

    <div class="form-layout">

      <!-- LEFT SIDE IMAGE SECTION -->
      <div class="left-visual">
        <div class="dot-pattern pattern-top"></div>
         <Image src={waterImage} alt="Handshake" class="handshake-img" />

        <div class="dot-pattern pattern-bottom"></div>
      </div>

      <!-- RIGHT SIDE – PLACE GHL FORM HERE -->
      <div class="right-form">
        <!-- ⭐ PASTE YOUR GHL FORM EMBED CODE HERE ⭐ -->
<iframe
    src="https://api.leadconnectorhq.com/widget/form/89hp1tUmrs62eQBalSLn"
    style="width:100%;height:100%;border:none;border-radius:3px"
    id="inline-89hp1tUmrs62eQBalSLn" 
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Employee Application Form"
    data-height="1055"
    data-layout-iframe-id="inline-89hp1tUmrs62eQBalSLn"
    data-form-id="89hp1tUmrs62eQBalSLn"
    title="Employee Application Form"
        >
</iframe>
<script src="https://link.msgsndr.com/js/form_embed.js"></script>
      </div>

    </div>

  </div>
</section>

</Layout>