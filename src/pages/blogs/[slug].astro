---
import blogs from "../../data/blogs.json";
import Layout from "../../layouts/Layout.astro";

const slug = Astro.params.slug;
const blog = blogs.find((b) => b.slug === slug);
if (!blog) {
  return new Response("Blog not found", { status: 404 });
}
---

<Layout title={blog.title} description={blog.title}>
    
    <section>
<div class="inner-banner">
  <div class="inner-banner-content">
    <h1>{blog.title}</h1>

  </div>
  </div>
</section>
    <section class="blog-detail pt-0">
  <div class="container">
    <div class="row">
      <!-- Main Content -->
      <div class="data">
        <article>
          <h2 data-aos="fade-up" data-aos-delay="0">{blog.title}</h2>
          {blog.image && (
            <img
              src={blog.deimage}
              alt={blog.title}
              width="600"
              class="ruroini"
              loading="eager"
              data-aos="fade-up"
              data-aos-delay="100"
            />
          )}
          {blog.date && (
            <p data-aos="fade-up" data-aos-delay="200">
              <small class="text-primary">{blog.date}</small>
            </p>
          )}
          <div class="content" set:html={blog.content}></div>
        </article>
      </div>

      <!-- Sidebar (optional) -->
      <aside>
        <!-- You can add related posts, categories, or ads here -->
      </aside>
    </div>
  </div>

  <style>
    .content.h2 {
    color: #0e8641;
}
    /* Container & Layout */
    .blog-detail .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 2rem;
    }

    .blog-detail .row {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .ruroini {
    width: 100%;}
    
    .blog-detail aside {
      flex: 1 1 30%;
      min-width: 250px;
    }

    /* Article Styling */
    .blog-detail article h2 {
      color: #0e8641; /* Header color */
      font-size: 2.5rem;
      margin-bottom: 1rem;
      line-height: 1.2;
      display: none;
    }
.content h2 {
    color: #0e8641;
}

    .blog-detail article img {
      max-width: 100%;
      height: auto;
      margin: 1.5rem 0;
      border-radius: 0.5rem;
    }

    .blog-detail article p {
      font-size: 1rem;
      line-height: 1.6; /* Proper line height */
      color: #333;
      margin-bottom: 1rem;
    }

    .blog-detail article small.text-primary {
      color: #ff0000; /* Optional: primary text color for date */
    }

    .blog-detail .content {
      font-size: 1rem;
      line-height: 1.6;
      color: #444;
    }

    .blog-detail .content p {
      margin-bottom: 1rem;
    }

    /* Headings inside content */
    .blog-detail .content h2,
    .blog-detail .content h3,
    .blog-detail .content h4 {
      color: red;
      margin-top: 1.5rem;
      margin-bottom: 1rem;
      line-height: 1.3;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .blog-detail .row {
        flex-direction: column;
      }
      .blog-detail aside {
        order: -1; /* Optional: move sidebar above content on mobile */
      }
      .blog-detail{
        font-size: 1.5rem !important; 

      }
    }




    :root {
  /* FONT FAMILY */
  --font-heading: "Plus Jakarta Sans", sans-serif;
  --font-content: "Plus Jakarta Sans", sans-serif;

}
body {
    margin: 0;
    font-family: var(--font-heading) !important;
   
}
.inner-banner {
  width: 100%;
  height: 350px;
  background: 
    linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)),
    url(../../assets/join-team/subcon-1.png);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
      background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-position: center 0px;
}

.inner-banner-content h1 {
  color: #fff;
  font-size: 48px;
  font-weight: 700;
  margin: 0;
  max-width: 1000px;
}

.inner-banner-content p {
  color: #e5e5e5;
  font-size: 18px;
  margin-top: 10px;
}
@media (max-width: 768px) {
  .inner-banner {
    height: 220px;
  }
.row {
    gap: 0px !important;
}
  .inner-banner-content h1 {
    font-size: 24px;
  }
   .blog-detail article h2 {
      color: #0e8641; /* Header color */
      font-size:22px !important;

    }
  .inner-banner-content p {
    font-size: 15px;
  }
}

  </style>
</section>

    
</Layout>