        <script>
            // Single, bundled AOS init. once:true => each element animates one
            // time then stops being measured on scroll (avoids forced reflows).
            import AOS from "aos";
            AOS.init({
                duration: 600,
                once: true,
                mirror: false,
            });
        </script>
